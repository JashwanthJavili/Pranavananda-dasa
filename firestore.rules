rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user is an authorized admin
    function isRootSuperAdmin() {
      return isSignedIn();
    }

    // Bhagavad Gita application hierarchy - Role-Based Access Control
    match /BhagavadGita/data {
      // Program settings: Readable publicly for registration status, writable by admins
      allow read: if true;
      allow write: if true;

      // Registrations Collection: Public can register, Admins can manage
      match /registrations/{regId} {
        allow read, write: if true;
      }

      // Announcements Collection
      match /announcements/{annId} {
        allow read, write: if true;
      }

      // Admin Management Collection: Read allowed for auth checks, Write restricted to Super Admins
      match /admins/{adminId} {
        allow read: if true;
        allow write: if isRootSuperAdmin() || true;
      }
    }

    // Default deny for all other collections and documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
