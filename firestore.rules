// FIRESTORE SECURITY RULES - GITA FOR YOUTH PORTAL

// Use Firestore Security Rules Version 2 (enables modern syntax & granular controls)
rules_version = '2';

// Apply rules to Google Cloud Firestore service
service cloud.firestore {

  // Match all document paths in the current project database
  match /databases/{database}/documents {
    
    // ---------------------------------------------------------------------------
    // AUTHENTICATION HELPER FUNCTIONS
    // ---------------------------------------------------------------------------

    // Helper: Checks if the incoming request has a valid, active Firebase Auth token
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Checks if the user is an authenticated administrator
    function isRootSuperAdmin() {
      return isSignedIn();
    }

    // ---------------------------------------------------------------------------
    // GITA FOR YOUTH ROOT PATH (/BhagavadGita/data)
    // ---------------------------------------------------------------------------
    match /BhagavadGita/data {

      // --- 1. Program Settings (Open/Paused Status, Notice Banner, Batch Defaults) ---
      // Public read is required so visitors can see if registrations are open or paused
      allow read: if true;
      // Coordinators can save program status updates and notice messages
      allow write: if true;

      // --- 2. Registrations Subcollection (/BhagavadGita/data/registrations/{regId}) ---
      match /registrations/{regId} {
        // Public read allows students to view their Pass on the Student Dashboard by Phone/ID
        // and enables the Admin Dashboard to list registered seekers
        allow read: if true;

        // Public write allows new seekers to submit their registration without needing pre-login,
        // and allows coordinators to update status or details
        allow write: if true;
      }

      // --- 3. Announcements Subcollection (/BhagavadGita/data/announcements/{annId}) ---
      match /announcements/{annId} {
        // Public read allows enrolled students to view course notices and schedules
        allow read: if true;

        // Coordinators can post, update, and manage announcements
        allow write: if true;
      }

      // --- 4. Coordinator Accounts (/BhagavadGita/data/admins/{adminId}) ---
      // Super Admin records decide who manages quizzes (answer keys, results), so only a
      // signed-in active Super Admin (their quiz-access account) may create, change or remove
      // one, or make someone a Super Admin. Ordinary Admin records stay open until the admin
      // login moves to Firebase Auth (Phase 2).
      match /admins/{adminId} {
        // Read is allowed so the Admin Login portal can verify coordinator credentials
        allow read: if true;
        allow create: if !isSuperRole(request.resource.data) || isSuperAdminCaller();
        allow update: if (!isSuperRole(resource.data) && !isSuperRole(request.resource.data)) || isSuperAdminCaller();
        allow delete: if !isSuperRole(resource.data) || isSuperAdminCaller();
      }

      // --- 5. Developer Trash & Archival Backups (/BhagavadGita/data/trash/{trashId}) ---
      match /trash/{trashId} {
        // Safe backend archiving for sequence reset & safety recovery
        allow read, write: if true;
      }

      // Allow any other subcollections under /BhagavadGita/data (admins has its own rules above;
      // rules are combined with OR, so this must not also match admins)
      match /{coll}/{rest=**} {
        allow read: if true;
        allow write: if coll != 'admins';
      }
    }

    // ---------------------------------------------------------------------------
    // STUDENT PORTAL (root level, so the open BhagavadGita/data wildcard does not apply)
    // ---------------------------------------------------------------------------

    // Signed in through Firebase Auth with an email address Firebase has verified
    function isVerifiedStudent() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function verifiedEmail() {
      return request.auth.token.email.lower();
    }

    // The registration exists, is active, and its email + mobile match the claim
    function registrationMatches(regId, mobileClean, countryCode) {
      let reg = get(/databases/$(database)/documents/BhagavadGita/data/registrations/$(regId)).data;
      return reg.get('isDeleted', false) != true
        && reg.get('mobileNumberClean', '') == mobileClean
        && reg.get('countryCode', '+91') == countryCode
        && (reg.get('emailLower', '') == verifiedEmail() || reg.get('email', '').lower() == verifiedEmail());
    }

    // One claim per registration. Create-only: a claim can never be moved to another account.
    match /portalLinks/{regId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isVerifiedStudent()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'mobileClean', 'countryCode', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == verifiedEmail()
        && request.resource.data.createdAt == request.time
        && registrationMatches(regId, request.resource.data.mobileClean, request.resource.data.countryCode)
        && getAfter(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.registrationId == regId;
      allow update, delete: if false;
    }

    // Each account points at exactly one registration it has claimed. Create-only.
    match /portalAccounts/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isVerifiedStudent()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['registrationId', 'email', 'createdAt'])
        && request.resource.data.email == verifiedEmail()
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/portalLinks/$(request.resource.data.registrationId)).data.uid == uid;
      // The only later change: recording that the student has created their password
      allow update: if isVerifiedStudent()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passwordSetAt'])
        && request.resource.data.passwordSetAt == request.time;
      allow delete: if false;
    }

    // The signed-in student's own phone key (+countrycode + mobile), taken from their claim
    function ownPhoneKey() {
      let regId = get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.registrationId;
      let link = get(/databases/$(database)/documents/portalLinks/$(regId)).data;
      return link.countryCode + link.mobileClean;
    }

    // Mobile number + password login. Holds the email ENCRYPTED with a key derived from the
    // student's password, so reading a document by phone number does not reveal the email.
    // Fetch by exact key only (no listing); only the owner can write their own phone key.
    match /portalLogins/{key} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isVerifiedStudent()
        && key == ownPhoneKey()
        && (resource == null || resource.data.uid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['uid', 'salt', 'iv', 'data', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Masked-email hints for "Don't remember which email you used?", keyed by +countrycode+mobile.
    // Holds only a masked email, so the full email is never sent to the browser.
    // Fetch by exact key only (no listing). Writes must point at a real registration with that number.
    function hintMatchesRegistration(key) {
      let reg = get(/databases/$(database)/documents/BhagavadGita/data/registrations/$(request.resource.data.registrationId)).data;
      return reg.get('isDeleted', false) != true
        && key == reg.get('countryCode', '+91') + reg.get('mobileNumberClean', '');
    }

    match /emailHints/{key} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['registrationId', 'maskedEmail', 'updatedAt'])
        && request.resource.data.registrationId is string
        && request.resource.data.maskedEmail is string
        && request.resource.data.maskedEmail.size() <= 120
        && request.resource.data.maskedEmail.matches('^[^@]{1,2}•{3,8}[^@]{0,2}@[^@]+$')
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/BhagavadGita/data/registrations/$(request.resource.data.registrationId))
        && hintMatchesRegistration(key);
      // Only once its registration is gone or marked deleted
      allow delete: if !exists(/databases/$(database)/documents/BhagavadGita/data/registrations/$(resource.data.registrationId))
        || get(/databases/$(database)/documents/BhagavadGita/data/registrations/$(resource.data.registrationId)).data.get('isDeleted', false) == true;
    }

    // ---------------------------------------------------------------------------
    // WEEKLY QUIZZES
    //   portalQuizzes/{quizId}               questions + options only (no answers)
    //   portalQuizKeys/{quizId}              correct answers, hidden until results are due
    //   quizProgress/{quizId}_{regId}        attempt count per student per quiz (absent = Not Attempted)
    //   quizAttempts/{quizId}_{regId}_{n}    submitted answers, create-only
    // Students only ever write answers. Scores are computed from answers + key, so they
    // cannot be changed by a student.
    // ---------------------------------------------------------------------------

    // Quiz managers: the Firebase Auth account (same email + password as the admin login) of
    // an active Super Admin, or of an email listed in quizManagers/{email} (Console only).
    // Super Admin records can only be created or changed by a signed-in Super Admin (see the
    // admins rules above), so nobody can make themselves a quiz manager.
    // Quiz-access accounts are named <admin doc id>@gfy-quiz.invalid; a real email maps to
    // the same doc id the admin dashboard uses (non a-z0-9 characters become _).
    function adminDocId() {
      let e = request.auth.token.email.lower();
      return e.matches('^[a-z0-9_]+@gfy-quiz[.]invalid$') ? e.split('@')[0] : e.replace('[^a-z0-9]', '_');
    }

    function adminRecord() {
      return get(/databases/$(database)/documents/BhagavadGita/data/admins/$(adminDocId())).data;
    }

    function isSuperRole(d) {
      return d.get('role', '') in ['Super Admin', 'Super Administrator'];
    }

    // A quiz-access account (<doc id>@gfy-quiz.invalid), or a real email Firebase has verified,
    // so nobody can claim an admin's address by just creating an account with it
    function trustedAdminEmail() {
      let e = request.auth.token.email.lower();
      return e.matches('^[a-z0-9_]+@gfy-quiz[.]invalid$') || request.auth.token.email_verified == true;
    }

    function isActiveSuperAdmin() {
      let a = adminRecord();
      return trustedAdminEmail()
        && isSuperRole(a)
        && a.get('isDeleted', false) != true
        && a.get('status', 'Active') != 'Revoked';
    }

    function isSuperAdminCaller() {
      return isSignedIn() && request.auth.token.email != null && isActiveSuperAdmin();
    }

    function isQuizManager() {
      return isSignedIn() && request.auth.token.email != null
        && (exists(/databases/$(database)/documents/quizManagers/$(request.auth.token.email.lower()))
            || isActiveSuperAdmin());
    }

    match /quizManagers/{email} {
      // A signed-in manager may check their own entry, nothing else
      allow get: if isSignedIn() && request.auth.token.email != null && email == request.auth.token.email.lower();
      allow list, write: if false;
    }

    // A verified student whose account is linked to a registration
    function isLinkedStudent() {
      return isVerifiedStudent() && exists(/databases/$(database)/documents/portalAccounts/$(request.auth.uid));
    }

    function myRegistrationId() {
      return get(/databases/$(database)/documents/portalAccounts/$(request.auth.uid)).data.registrationId;
    }

    function quizDoc(quizId) {
      return get(/databases/$(database)/documents/portalQuizzes/$(quizId)).data;
    }

    function validQuiz(d) {
      return d.keys().hasOnly(['title', 'weekNumber', 'description', 'instructions', 'opensAt', 'closesAt',
          'maxAttempts', 'scorePolicy', 'questions', 'questionCount', 'published', 'publishedAt',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && (d.get('weekNumber', null) == null || d.weekNumber is int)
        && d.questions is list && d.questions.size() <= 100
        && d.questionCount == d.questions.size()
        && d.maxAttempts is int && d.maxAttempts >= 1 && d.maxAttempts <= 5
        && d.scorePolicy in ['best', 'latest']
        && d.published is bool
        && (d.get('opensAt', null) == null || d.opensAt is timestamp)
        && (d.get('closesAt', null) == null || d.closesAt is timestamp)
        // A published quiz must have questions and an opening time
        && (d.published == false || (d.questions.size() > 0 && d.get('opensAt', null) is timestamp))
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.token.email.lower();
    }

    match /portalQuizzes/{quizId} {
      // Students see published quizzes only; managers see everything (drafts too)
      allow get, list: if isQuizManager() || (isLinkedStudent() && resource.data.published == true);
      allow create: if isQuizManager()
        && validQuiz(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.get('publishedAt', null) == (request.resource.data.published ? request.time : null);
      allow update: if isQuizManager()
        && validQuiz(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        // publishedAt records the first publish and never changes after that
        && (resource.data.get('publishedAt', null) != null
              ? request.resource.data.get('publishedAt', null) == resource.data.publishedAt
              : request.resource.data.get('publishedAt', null) == (request.resource.data.published ? request.time : null));
      // Only drafts that were never published, so no attempt history is ever orphaned
      allow delete: if isQuizManager() && resource.data.get('publishedAt', null) == null;
    }

    // Results are due once the student has used every attempt, chose to finish early,
    // or the quiz has closed.
    function resultsReleased(quizId) {
      let quiz = quizDoc(quizId);
      let progress = get(/databases/$(database)/documents/quizProgress/$(quizId + '_' + myRegistrationId())).data;
      // On closing, only after the 2-minute submission grace, so nobody can read the
      // answers and still submit another attempt
      return progress.uid == request.auth.uid
        && (progress.finished == true
            || progress.attempts >= quiz.maxAttempts
            || (quiz.get('closesAt', null) != null && request.time > quiz.closesAt + duration.value(2, 'm')));
    }

    match /portalQuizKeys/{quizId} {
      allow get: if isQuizManager() || (isLinkedStudent() && resultsReleased(quizId));
      allow list: if isQuizManager();
      allow create, update: if isQuizManager()
        && request.resource.data.keys().hasOnly(['answers', 'explanations', 'updatedAt'])
        && request.resource.data.answers is map
        && request.resource.data.updatedAt == request.time;
      allow delete: if isQuizManager() && quizDoc(quizId).get('publishedAt', null) == null;
    }

    function progressPath(pid) {
      return /databases/$(database)/documents/quizProgress/$(pid);
    }

    function attemptPath(aid) {
      return /databases/$(database)/documents/quizAttempts/$(aid);
    }

    match /quizProgress/{pid} {
      allow get, list: if isQuizManager() || (isSignedIn() && resource.data.uid == request.auth.uid);
      // First attempt (written in the same batch as quizAttempts/{pid}_1)
      allow create: if isLinkedStudent()
        && request.resource.data.keys().hasOnly(['quizId', 'registrationId', 'uid', 'attempts', 'finished', 'firstSubmittedAt', 'lastSubmittedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.registrationId == myRegistrationId()
        && pid == request.resource.data.quizId + '_' + request.resource.data.registrationId
        && request.resource.data.attempts == 1
        && request.resource.data.finished == false
        && request.resource.data.firstSubmittedAt == request.time
        && request.resource.data.lastSubmittedAt == request.time
        && existsAfter(attemptPath(pid + '_1'));
      allow update: if isLinkedStudent() && resource.data.uid == request.auth.uid && (
          // A retake (written in the same batch as its attempt)
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attempts', 'lastSubmittedAt'])
            && request.resource.data.attempts == resource.data.attempts + 1
            && request.resource.data.lastSubmittedAt == request.time
            && resource.data.finished == false
            && existsAfter(attemptPath(pid + '_' + string(request.resource.data.attempts))))
          // Finishing early to see results (gives up remaining attempts)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['finished'])
            && request.resource.data.finished == true)
        );
      allow delete: if false;
    }

    match /quizAttempts/{aid} {
      allow get, list: if isQuizManager() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isLinkedStudent() && attemptAllowed(aid, request.resource.data);
      allow update, delete: if false;
    }

    function attemptAllowed(aid, d) {
      let quiz = quizDoc(d.quizId);
      let pid = d.quizId + '_' + d.registrationId;
      return d.keys().hasOnly(['quizId', 'registrationId', 'uid', 'attemptNumber', 'answers', 'submittedAt', 'timeTakenSec'])
        // Time the student spent answering (reported by their device; up to 30 days)
        && (d.get('timeTakenSec', null) == null
          || (d.timeTakenSec is int && d.timeTakenSec >= 0 && d.timeTakenSec <= 2592000))
        && d.uid == request.auth.uid
        && d.registrationId == myRegistrationId()
        && d.attemptNumber is int
        && d.attemptNumber >= 1
        && d.attemptNumber <= quiz.maxAttempts
        && aid == pid + '_' + string(d.attemptNumber)
        // The progress doc in the same batch counts this attempt (so attempts go 1, 2, 3...)
        && getAfter(progressPath(pid)).data.attempts == d.attemptNumber
        && (!exists(progressPath(pid)) || get(progressPath(pid)).data.finished == false)
        && quiz.published == true
        && request.time >= quiz.opensAt
        // Two minutes of grace for a submission sent just before closing
        && (quiz.get('closesAt', null) == null || request.time <= quiz.closesAt + duration.value(2, 'm'))
        && d.answers is map
        && d.answers.size() <= quiz.questionCount
        && d.submittedAt == request.time;
    }

    // Direct root level trash backup fallback
    match /trash/{trashId} {
      allow read, write: if true;
    }

    // ---------------------------------------------------------------------------
    // GLOBAL SECURITY FALLBACK (DEFAULT DENY)
    // ---------------------------------------------------------------------------
    // Blocks all read/write requests to any collection or document outside of allowed paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
